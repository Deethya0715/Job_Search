# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

# Recipient defaults to profile.json email if REPORT_TO is blank.
REPORT_TO=

# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# Other providers: use their SMTP host/port and an app-specific password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional RapidAPI JSearch key (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# The aggregator still works without this via JobSpy + Greenhouse + Lever.
RAPIDAPI_KEY=

# Google Sheets tracker
# Spreadsheet: https://docs.google.com/spreadsheets/d/1TO5rtMymBoo64X2bld2R-HqBGlWim_m7kHNcHkICtxY/edit
GOOGLE_SHEETS_ID=1TO5rtMymBoo64X2bld2R-HqBGlWim_m7kHNcHkICtxY
# Leave blank to use the first tab. Set this if your tracker is not Sheet1.
GOOGLE_SHEETS_WORKSHEET=
# Path to the Google Cloud service-account JSON (Editor access on the sheet).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Hourly scrapes, inclusive clock hours in America/Chicago (8 = 8:00 AM, 19 = 7:00 PM).
SCRAPE_HOURS_START=8
SCRAPE_HOURS_END=19

# Automatic Playwright apply for newly discovered $150k+ matches.
# 1 = launch bot.py after each scrape (fills Greenhouse/Lever/Ashby forms).
AUTO_PREP=1
# 1 = also click Submit. 0 = fill the form and pause for you.
AUTO_SUBMIT=1
# Max forms per bot session (0 = all queued Greenhouse/Lever/Ashby matches).
AUTO_PREP_LIMIT=0
# 1 = hide the browser window. 0 = show Chromium so you can watch it work.
PLAYWRIGHT_HEADLESS=0
